# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL is recommended in production. SQLite is the local default.
DATABASE_URL=postgresql://user:password@localhost:5432/autotime

# Use an application-specific SMTP credential, never an account password.
SMTP_EMAIL=notifications@example.com
SMTP_PASSWORD=replace-with-an-app-password

SESSION_COOKIE_SECURE=true
AUTO_CREATE_SCHEMA=false
FLASK_DEBUG=false
